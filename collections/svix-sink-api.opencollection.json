            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.eu.svix.com/api/v1/stream/:stream_id/sink",
            "params": [
              {
                "name": "stream_id",
                "value": "",
                "type": "path",
                "description": "The Stream's ID or UID."
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Limit the number of returned items"
              },
              {
                "name": "iterator",
                "value": "",
                "type": "query",
                "description": "The iterator returned from a prior invocation"
              },
              {
                "name": "order",
                "value": "",
                "type": "query",
                "description": "The sorting order of the returned items"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "List of all the stream's sinks."
