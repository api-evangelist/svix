  "items": [
    {
      "info": {
        "name": "Endpoint",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Endpoints",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.eu.svix.com/api/v1/app/:app_id/endpoint",
            "params": [
              {
                "name": "app_id",
                "value": "",
                "type": "path",
                "description": "The Application's ID or UID."
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Limit the number of returned items"
              },
              {
                "name": "iterator",
                "value": "",
                "type": "query",
                "description": "The iterator returned from a prior invocation"
              },
              {
                "name": "order",
                "value": "",
                "type": "query",
                "description": "The sorting order of the returned items"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "List the application's endpoints."
        },
        {
          "info": {
            "name": "Create Endpoint",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.eu.svix.com/api/v1/app/:app_id/endpoint",
            "headers": [
