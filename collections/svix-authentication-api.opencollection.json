{
  "opencollection": "1.0.0",
  "info": {
    "name": "Svix Application Authentication API",
    "version": "1.84.0"
  },
  "items": [
    {
      "info": {
        "name": "Authentication",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Consumer App Portal Access",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.eu.svix.com/api/v1/auth/app-portal-access/:app_id",
            "headers": [
              {
                "name": "idempotency-key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "app_id",
                "value": "",
                "type": "path",
                "description": "The Application's ID or UID."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Use this function to get magic links (and authentication codes) for connecting your users to the Consumer Application Portal."
        },
        {
          "info": {
            "name": "Expire All",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.eu.svix.com/api/v1/auth/app/:app_id/expire-all",
            "headers": [
              {
                "name": "idempotency-key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "app_id",
                "value": "",
                "type": "path",
                "description": "The Application's ID or UID."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Expire all of the tokens associated with a specific application."
        },
        {
          "info": {
            "name": "Logout",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.eu.svix.com/api/v1/auth/logout",
            "headers": [
              {
                "name": "idempotency-key",
                "value": ""
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Logout an app token.\n\nTrying to log out other tokens will fail."
        }
      ]
    }
  ],
  "bundled": true
}